{
  "name": "barkerbot",
  "productName": "Barkerbot Admin Center",
  "version": "0.1.0",
  "description": "Hybrid Active Directory + Entra ID admin console with M365-admin-center styling",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@azure/msal-node": "2.16.2"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.73.0",
    "@fluentui/react-icons": "^2.0.320",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
